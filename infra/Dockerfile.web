# Web container: the Streamlit mobile website. Build from the repo root:
#   docker build -f infra/Dockerfile.web -t scam-map-web .
# Talks to the API at SCAM_MAP_API_URL; deployed as its own service (DECISIONS D55).
# Owner: A. Filled in by: A0.

FROM ghcr.io/astral-sh/uv:0.12.7 AS uv

FROM python:3.12.10-slim
COPY --from=uv /uv /usr/local/bin/uv

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    SCAM_MAP_SHARED_DIR=/srv/shared \
    PORT=8501

WORKDIR /srv/web
COPY web/pyproject.toml web/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY web/app.py ./
COPY web/scam_web ./scam_web
COPY web/.streamlit ./.streamlit
COPY shared /srv/shared

RUN useradd --system --user-group --uid 10001 app
USER app
EXPOSE 8501

CMD ["sh", "-c", "exec /opt/venv/bin/streamlit run app.py --server.port \"$PORT\" --server.address 0.0.0.0"]
